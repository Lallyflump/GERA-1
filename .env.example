# Other configuration names are proposed; the provider keys are read from the process environment.
GERA_BUSINESS_PROFILE=config/business.example.json
GERA_ENV=development
# The Toby adapter reads this from the current terminal environment; never save a real key here.
NEBIUS_API_KEY=
# Optional Percival public research. Runtime reads this from the server environment.
TAVILY_API_KEY=
